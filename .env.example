# ==============================================================================
# CoinDCX Quant Futures Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env or real credentials to source control!
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development

# Server Port
PORT=3000

# Logging Level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# MySQL 8 Database Connection String
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://quant_user:quant_password@localhost:3306/coindcx_quant"

# CoinDCX API Credentials (RESERVED FOR FUTURE PHASES - NOT USED IN PHASE 1)
# Leave empty or unset during Phase 1 foundation development.
COINDCX_API_KEY=
COINDCX_API_SECRET=

